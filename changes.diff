+
+  if (!customers.length) {
+    container.innerHTML = '<div style="padding: 10px 12px; color: var(--text-muted); font-size: 0.85rem;">Sin resultados</div>';
+    dropdown.style.display = 'block';
+    return;
+  }
+
+  container.innerHTML = '';
+  customers.forEach(function(c) {
